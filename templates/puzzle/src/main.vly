// {{name}}: CRATES, a Sokoban-style puzzle. D-pad walks and pushes, B undoes a move, SELECT restarts the level.
//   Push every crate onto a goal (the round marks). Your progress and best move counts are saved.
// Shows: tilemaps scanned into a grid, tables of level data, an undo history, save data, held-button repeat.
// Levels are drawn as ASCII art in assets/level*.map; add one and list it in the tables below.

import "std/tunes";

tileset art = "../assets/gfx.tiles";
tilemap lv1 = "../assets/level1.map";
tilemap lv2 = "../assets/level2.map";
tilemap lv3 = "../assets/level3.map";
tilemap lv4 = "../assets/level4.map";
tilemap lv5 = "../assets/level5.map";
tilemap lv6 = "../assets/level6.map";
tilemap lv7 = "../assets/level7.map";

const T = 100;                       // the art tiles live at 100.. in tile RAM (the font is at 0..94)
const NLEVELS = 7;
const GW = 20;                       // grid row stride: the screen is 20 cells wide
const F_WALL = 1; const F_GOAL = 2; const F_CRATE = 4; const F_VOID = 8;
const S_TITLE = 0; const S_PLAY = 1; const S_CLEAR = 2; const S_WIN = 3;
const HIST = 400;

table widths = { lv1_W, lv2_W, lv3_W, lv4_W, lv5_W, lv6_W, lv7_W };
table heights = { lv1_H, lv2_H, lv3_H, lv4_H, lv5_H, lv6_H, lv7_H };
table start_x = { lv1_P_X, lv2_P_X, lv3_P_X, lv4_P_X, lv5_P_X, lv6_P_X, lv7_P_X };
table start_y = { lv1_P_Y, lv2_P_Y, lv3_P_Y, lv4_P_Y, lv5_P_Y, lv6_P_Y, lv7_P_Y };

byte grid[320];                      // one flag byte per cell, rows GW apart
byte hist[400];                      // undo history: direction | pushed << 2
var state;
var level;                           // 0-based
var progress;                        // levels solved in a row from the start (saved)
var sel;                             // level chosen on the title screen
var moves; var nhist;
var px; var py; var face;            // the worker's cell and facing
var gw; var gh; var ox; var oy;      // level size and where it sits on screen (cells)
var left;                            // crates not yet on a goal
var rep;                             // frames until a held direction repeats
var beep; var timer; var best;

// A tilemap is a symbol (an address), so it cannot sit in a table; pick it with a chain of ifs instead.
func map_of(n) {
  if (n == 0) { return lv1; } if (n == 1) { return lv2; } if (n == 2) { return lv3; } if (n == 3) { return lv4; }
  if (n == 4) { return lv5; } if (n == 5) { return lv6; }
  return lv7;
}

func best_of(n) { return save_get(2 + n * 2); }

func sound(hz, frames) {
  sfx_tone(1, hz, 10, 2, frames);     // effects on channel 1; the music has 0 and 2
  beep = frames;
}

func draw_cell(x, y) {
  var f = grid[y * GW + x];
  var t = T + art_floor;
  if (f & F_VOID) { t = T + art_void; }
  else if (f & F_WALL) { t = T + art_wall; }
  else if (f & F_CRATE) {
    if (f & F_GOAL) { t = (T + art_crate) | (2 << 12); } else { t = (T + art_crate) | (1 << 12); }
  }
  else if (f & F_GOAL) { t = T + art_goal; }
  set_cell(ox + x, oy + y, t);
}

func draw_hud() {
  text(0, 0, "LEVEL");
  print_u(6, 0, level + 1);
  text(12, 0, "BEST");
  if (best > 0) { print_u(17, 0, best); } else { text(17, 0, "--   "); }
  text(0, 1, "MOVES");
  print_u(6, 1, moves);
}

func load_level(n) {
  level = n;
  clear_bg();
  var src = map_of(n);
  gw = widths[n];
  gh = heights[n];
  ox = (20 - gw) / 2;
  oy = 2 + (15 - gh) / 2;
  fill(grid, 0, 320);
  left = 0;
  for (var y = 0; y < gh; y++) {
    for (var x = 0; x < gw; x++) {
      var v = map_cell(src, gw, x, y);
      var tile = v & 0xFFF;
      var f = 0;
      if (tile == T + art_wall) { f = F_WALL; }
      else if (tile == T + art_void) { f = F_VOID; }
      else if (tile == T + art_goal) { f = F_GOAL; }
      else if (tile == T + art_crate) {
        if (((v >> 12) & 7) == 2) { f = F_CRATE | F_GOAL; } else { f = F_CRATE; left++; }
      }
      grid[y * GW + x] = f;
      draw_cell(x, y);
    }
  }
  px = start_x[n]; py = start_y[n];
  face = 1; moves = 0; nhist = 0; rep = 0;
  best = best_of(n);
  text(0, 17, "B:UNDO SELECT:RESET ");
  draw_hud();
  state = S_PLAY;
}

func put_hist(d, pushed) {
  if (nhist == HIST) { copy(hist, hist + 1, HIST - 1); nhist = HIST - 1; }
  hist[nhist] = d | (pushed << 2);
  nhist++;
}

func solved() {
  state = S_CLEAR;
  timer = 0;
  if (best == 0 || moves < best) { best = moves; save_set(2 + level * 2, moves); }
  if (level + 1 > progress) { progress = level + 1; save_set(0, progress); }
  save_seal();
  save_commit();
  draw_hud();
  text(12, 1, "SOLVED!");
  text(0, 17, "A: CONTINUE         ");
  sound(660, 8);
}

func try_move(d) {
  var dx = (d == 3) - (d == 2);
  var dy = (d == 1) - (d == 0);
  face = d;
  var nx = px + dx;
  var ny = py + dy;
  var f = grid[ny * GW + nx];
  if (f & (F_WALL | F_VOID)) { sound(110, 3); return; }
  var pushed = 0;
  if (f & F_CRATE) {
    var bx = nx + dx;
    var by = ny + dy;
    var g = grid[by * GW + bx];
    if (g & (F_WALL | F_VOID | F_CRATE)) { sound(110, 3); return; }
    grid[ny * GW + nx] = f - F_CRATE;
    grid[by * GW + bx] = g | F_CRATE;
    if (f & F_GOAL) { left++; }
    if (g & F_GOAL) { left--; }
    draw_cell(nx, ny);
    draw_cell(bx, by);
    pushed = 1;
  }
  px = nx;
  py = ny;
  moves++;
  put_hist(d, pushed);
  if (pushed) { sound(196, 4); } else { sound(330, 2); }
  draw_hud();
  if (left == 0) { solved(); }
}

func undo() {
  if (nhist == 0) { return; }
  nhist--;
  var h = hist[nhist];
  var d = h & 3;
  var dx = (d == 3) - (d == 2);
  var dy = (d == 1) - (d == 0);
  if (h >> 2) {
    var cx = px + dx;
    var cy = py + dy;
    var f = grid[cy * GW + cx];
    var g = grid[py * GW + px];
    grid[cy * GW + cx] = f - F_CRATE;
    grid[py * GW + px] = g | F_CRATE;
    if (f & F_GOAL) { left++; }
    if (g & F_GOAL) { left--; }
    draw_cell(cx, cy);
    draw_cell(px, py);
  }
  px = px - dx;
  py = py - dy;
  moves--;
  face = d;
  draw_hud();
  sound(262, 3);
}

// One direction per frame; a fresh press moves at once, a held button repeats after a short delay.
func read_dir() {
  var d = 0 - 1;
  if (btn(BTN_UP)) { d = 0; }
  else if (btn(BTN_DOWN)) { d = 1; }
  else if (btn(BTN_LEFT)) { d = 2; }
  else if (btn(BTN_RIGHT)) { d = 3; }
  if (d < 0) { rep = 0; return d; }
  if (btnp(BTN_UP | BTN_DOWN | BTN_LEFT | BTN_RIGHT)) { rep = 10; return d; }
  if (rep > 0) { rep--; if (rep == 0) { rep = 4; return d; } }
  return 0 - 1;
}

func title_screen() {
  text(7, 3, "CRATES");
  text(3, 5, "PUSH THEM HOME");
  text(5, 9, "LEVEL");
  print_u(11, 9, sel + 1);
  if (sel > 0) { text(3, 9, "<"); } else { text(3, 9, " "); }
  if (sel < progress && sel + 1 < NLEVELS) { text(16, 9, ">"); } else { text(16, 9, " "); }
  text(5, 11, "BEST");
  if (best_of(sel) > 0) { print_u(10, 11, best_of(sel)); } else { text(10, 11, "--   "); }
  text(4, 14, "PRESS START");
  if (btnp(BTN_LEFT) && sel > 0) { sel--; }
  if (btnp(BTN_RIGHT) && sel < progress && sel + 1 < NLEVELS) { sel++; }
  if (btnp(BTN_START) || btnp(BTN_A)) { load_level(sel); }
}

func play() {
  if (btnp(BTN_SELECT)) { load_level(level); return; }
  if (btnp(BTN_B)) { undo(); return; }
  var d = read_dir();
  if (d >= 0) { try_move(d); }
}

func clear_screen() {
  if (btnp(BTN_A) || btnp(BTN_START)) {
    if (level + 1 < NLEVELS) { load_level(level + 1); }
    else {
      state = S_WIN;
      hide_sprite(0);
      clear_bg();
    }
  }
}

func win_screen() {
  text(3, 6, "ALL CRATES HOME!");
  text(4, 9, "YOU ARE A PRO");
  text(4, 13, "PRESS START");
  if (btnp(BTN_START)) { state = S_TITLE; sel = 0; clear_bg(); }
}

func frame() {
  music_update(); sfx_update();
  if (state == S_TITLE) { title_screen(); }
  else if (state == S_PLAY) { play(); }
  else if (state == S_CLEAR) { clear_screen(); }
  else { win_screen(); }

  if (state == S_PLAY || state == S_CLEAR) {
    var t = T + art_hero_d;
    var a = 0;
    if (face == 0) { t = T + art_hero_u; }
    if (face >= 2) { t = T + art_hero_s; }
    if (face == 2) { a = SPR_FLIPX; }
    sprite(0, (ox + px) * 8, (oy + py) * 8, t, a);
  } else {
    hide_sprite(0);
  }
  if (beep > 0) { beep--; if (beep == 0) { tone_off(1); } }
}

func init() {
  load_font(0);
  load_tiles(art, T, art_COUNT);
  bg_pal(0, rgb(13, 12, 10), rgb(10, 9, 7), rgb(8, 5, 4), rgb(2, 1, 2));
  bg_pal(1, rgb(15, 13, 6), rgb(14, 10, 3), rgb(9, 5, 1), rgb(3, 1, 0));
  bg_pal(2, rgb(11, 15, 9), rgb(6, 13, 5), rgb(2, 9, 3), rgb(0, 3, 1));
  obj_pal(0, 0, rgb(15, 12, 9), rgb(3, 7, 14), rgb(2, 1, 1));
  hide_all_sprites();
  master_volume(8);
  tune_play(TUNE_SPACE);
  progress = 0;
  if (save_loaded() && save_valid()) { progress = min(save_get(0), NLEVELS - 1); }
  sel = progress;
  state = S_TITLE;
  lcd(LCD_BG | LCD_OBJ);
}
