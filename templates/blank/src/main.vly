func init() {
  load_font(0);                                   // the built-in font -> tiles 0..94
  bg_pal(0, rgb(15, 15, 15), rgb(11, 12, 14), rgb(5, 7, 11), rgb(1, 1, 4));
  hide_all_sprites();
  text(1, 1, "{{name}}");
  lcd(LCD_BG);
}

