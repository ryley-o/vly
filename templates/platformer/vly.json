{
  "name": "{{name}}",
  "entry": "src/main.vly",
  "out": "build/{{name}}.vlc",
  "tests": [
    {
      "name": "title screen",
      "frames": 20,
      "expect": {
        "words": {
          "state": 0
        },
        "frameHash": "9b443934f4de2a2f8d6354b25c0f471def46fa0c94b78606fa6587a5afc60cf4"
      }
    },
    {
      "name": "START begins level 1 with three lives",
      "frames": 30,
      "input": "START@5",
      "expect": {
        "words": {
          "state": 1,
          "lives": 3,
          "level": 0,
          "coins": 0
        },
        "frameHash": "6dfb2fa770002a83156ee9201e2fe09974cfd92773d127f1aa224974da27a99d"
      }
    },
    {
      "name": "running into the first enemy costs a life",
      "frames": 90,
      "input": "START@5, RIGHT@10-89",
      "expect": {
        "words": {
          "state": 1,
          "lives": 2
        },
        "maxCycles": 60000
      }
    },
    {
      "name": "a bot that jumps the enemies and pits clears level 1 with all 8 coins",
      "frames": 165,
      "input": "START@5, RIGHT@10-165, A@45-59, A@91-105, A@108-122",
      "expect": {
        "words": {
          "state": 2,
          "lives": 3,
          "coins": 8,
          "score": 80
        },
        "frameHash": "2141d3f8a2d759d61fa0127142425b79ad7cd233c222014bc4717c3883941c50",
        "maxCycles": 60000
      }
    },
    {
      "name": "an idle hero survives a long session without faults",
      "frames": 2400,
      "input": "START@5",
      "expect": {
        "maxCycles": 60000
      }
    }
  ]
}
