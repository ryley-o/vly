// {{name}}: move the hero with the D-pad. Press A to add to the score.
// Full language reference: `vly docs language`. Standard library: `vly docs stdlib`.

tileset art = "../assets/hero.tiles";   // tiles from a text file; defines art_hero, art_COUNT, ...

var x = 72;
var y = 64;
var score;

func init() {
  load_font(0);                          // built-in font -> tiles 0..94 (tile 0 is a blank space)
  load_tiles(art, 100, art_COUNT);       // our hero -> tiles 100..103
  bg_pal(0, rgb(15, 15, 15), rgb(11, 12, 14), rgb(5, 7, 11), rgb(1, 1, 4));
  obj_pal(0, 0, rgb(15, 14, 10), rgb(15, 8, 2), rgb(5, 1, 0));
  hide_all_sprites();
  text(1, 1, "HELLO, VLY-1!");
  text(1, 3, "A: SCORE");
  lcd(LCD_BG | LCD_OBJ);
}

func frame() {
  x = clamp(x + btn(BTN_RIGHT) - btn(BTN_LEFT), 0, SCREEN_W - 16);
  y = clamp(y + btn(BTN_DOWN) - btn(BTN_UP), 0, SCREEN_H - 16);
  if (btnp(BTN_A)) { score++; }
  sprite(0, x, y, 100 + art_hero, SPR_16X16);
  print_u(1, 5, score);
}
