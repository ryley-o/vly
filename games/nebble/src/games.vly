// The three mini-games (CATCH, COPY ME, HOP) and the result screen. Each ends by calling mg_finish(stars).
// Sprite slots: 0 pet, 1 face, 8..15 game objects, 20..22 lives.

const C_TOTAL = 30;       // things that fall in CATCH
const H_TOTAL = 14;       // obstacles in HOP
const CP_ROUNDS = 6;      // rounds in COPY ME

var mg_id; var mg_score; var mg_lives; var mg_t; var mg_phase; var mg_stars; var mg_new;
var mg_hold;              // frames to hold a screen before it ends (the "oh no" beat)

// ----- CATCH -----
var ix[6]; var iy[6]; var ik[6]; var isp[6];
var c_spawned; var c_next; var c_x; var c_inv;
// ----- COPY ME -----
byte seq[10];
var cp_round; var cp_len; var cp_i; var cp_lit; var cp_litt;
// ----- HOP -----
var ox[3]; var ok_[3]; var oh[3];
var h_spawned; var h_next; var h_jy; var h_vy; var h_buf; var h_inv; var h_x; var h_speed; var h_ground;

func hearts_draw() {
  for (var i = 0; i < 3; i++) {
    if (i < mg_lives) { sprite(20 + i, 128 + i * 10, 4, T + art_fx_heart, 2); } else { hide_sprite(20 + i); }
  }
}
func hud_score() { puts(7, 0, "SCORE"); print_u(13, 0, mg_score); }

func mg_enter(s) bank 8 {
  mg_id = s - S_CATCH; mg_score = 0; mg_lives = 3; mg_t = 0; mg_phase = 0; mg_hold = 0; face_ovr = -1; tmoving = 0;
  anim = 0; pdir = 1;
  var sz = pet_size();
  if (s == S_CATCH) {
    puts(0, 0, "CATCH"); hud_score();
    puts(1, 14, "LEFT/RIGHT: MOVE"); puts(0, 15, "CATCH FOOD, NO ROCKS");
    c_spawned = 0; c_next = 50; c_x = 80 - sz / 2; c_inv = 0;
    for (var i = 0; i < 6; i++) { ik[i] = 0; }
    pxx = c_x;
    music_later = MU_GAME;
  } else if (s == S_COPY) {
    puts(0, 0, "COPY ME"); puts(8, 0, "ROUND"); print_u(14, 0, 1);
    puts(1, 14, "WATCH THE ARROWS..."); puts(1, 15, "THEN COPY THEM!");
    cp_round = 1; cp_len = 3; cp_i = 0; cp_lit = -1; cp_litt = 0; mg_phase = 0; mg_t = 70;
    for (var i = 0; i < 10; i++) { seq[i] = rand(4); }
    pxx = 80 - sz / 2;
    music_set(MU_NONE);
  } else {
    puts(0, 0, "HOP"); hud_score();
    puts(1, 14, "A: JUMP OVER BLOCKS"); puts(1, 15, "BIRDS: DON'T JUMP");
    h_spawned = 0; h_next = 70; h_jy = 0; h_vy = 0; h_buf = 0; h_inv = 0; h_x = 24; h_ground = 1;
    for (var i = 0; i < 3; i++) { ok_[i] = 0; }
    pxx = h_x;
    music_later = MU_HOP;
  }
  hearts_draw();
}

// credit the result: fun, energy, hunger, tallies, bests; then show the result panel
func mg_finish(stars) bank 8 {
  mg_stars = stars;
  n_play++; if (stars >= 1) { n_win++; }
  mg_new = 0;
  if (mg_score > best[mg_id]) { best[mg_id] = mg_score; mg_new = 1; }
  var gain = 6; if (stars == 1) { gain = 14; } if (stars == 2) { gain = 24; } if (stars == 3) { gain = 34; }
  fun = min(99, fun + gain); nrg = max(0, nrg - 10); hun = max(0, hun - 6);
  sv_dirty = 1; save_game();
  state = S_RESULT; mg_t = 0;
  for (var i = 8; i < 24; i++) { hide_sprite(i); }
  fill_cells(2, 2, 16, 7, BLANK); clr_rows(14, 15);
  if (stars == 0) { puts(7, 3, "OH WELL!"); } else if (stars == 1) { puts(8, 3, "NICE!"); } else if (stars == 2) { puts(8, 3, "GREAT!"); } else { puts(6, 3, "PERFECT!!"); }
  for (var i = 0; i < stars; i++) { set_cell(6 + i * 3, 4, T + art_it_star + (5 << 12)); }
  puts(4, 6, "SCORE"); print_u(10, 6, mg_score);
  puts(4, 7, "BEST"); print_u(10, 7, best[mg_id]);
  puts(4, 8, "FUN"); puts(8, 8, "+"); print_u(9, 8, gain);
  if (mg_new && mg_score > 0) { puts(11, 8, "NEW BEST!"); }
  puts(1, 15, "A: BACK HOME");
  music_stop_all(); mu_now = MU_NONE;
  if (stars > 0) { snd_star(stars); } else { snd_fail(); }
  bcnt = 0;
}
func result_frame() {
  mg_t++;
  var y = 0;
  if (mg_stars > 0) { var b = (mg_t >> 1) & 31; if (b < 16) { y = (sin(b * 8) * 6) >> 8; } }
  anim = (mg_t >> 4) & 1;
  pet_draw(mg_stars > 0 ? M_JOY : M_SAD_(), y);
  if (mg_t > 30 && btnp(BTN_A | BTN_START)) { snd_ok(); go(S_ROOM); }
}
func M_SAD_() { return M_BORED; }

// ---------------- CATCH ----------------
func catch_frame() bank 7 {
  var sz = pet_size();
  var m = M_OK;
  if (mg_hold > 0) { mg_hold--; if (mg_hold == 0) { mg_finish(catch_stars()); } }
  else {
    if (btn(BTN_LEFT)) { c_x = c_x - 2; pdir = -1; tmoving = 1; } else if (btn(BTN_RIGHT)) { c_x = c_x + 2; pdir = 1; tmoving = 1; } else { tmoving = 0; }
    c_x = clamp(c_x, 4, 156 - sz);
    pxx = c_x;
    c_next--;
    if (c_next <= 0 && c_spawned < C_TOTAL) {
      for (var i = 0; i < 6; i++) {
        if (ik[i] == 0 && c_next <= 0) {
          var r = rand(100); var k = 1 + rand(2);
          if (r < 20) { k = 4; } else if (r < 30) { k = 3; }
          ik[i] = k; ix[i] = 6 + rand(140); iy[i] = 20 * 8; isp[i] = 10 + c_spawned / 2;
          c_spawned++; c_next = max(16, 38 - c_spawned) + rand(14);
        }
      }
    }
    var top = PYB + 1 - sz;
    var alive = 0;
    for (var i = 0; i < 6; i++) {
      if (ik[i] != 0) {
        iy[i] = iy[i] + isp[i];
        var y = iy[i] >> 3;
        if (y + 8 >= top + 4 && y <= top + 16 && ix[i] + 8 > c_x + 3 && ix[i] < c_x + sz - 3) {
          if (ik[i] == 4) { mg_lives--; c_inv = 40; sfx_play(SFX_HIT); hearts_draw(); }
          else { var g = 1; if (ik[i] == 3) { g = 2; } mg_score += g; hud_score(); sfx_play(SFX_COIN); mg_t = 24; }
          ik[i] = 0; hide_sprite(8 + i);
        } else if (y > PYB - 7) { ik[i] = 0; hide_sprite(8 + i); }
        else { alive++; var pal = 2; var tl = art_it_apple; if (ik[i] == 2) { pal = 4; tl = art_it_cookie; } if (ik[i] == 3) { pal = 1; tl = art_it_star; } if (ik[i] == 4) { pal = 5; tl = art_it_rock; } sprite(8 + i, ix[i], y, T + tl, pal); }
      }
    }
    if (mg_lives <= 0) { mg_hold = 50; for (var i = 0; i < 6; i++) { ik[i] = 0; hide_sprite(8 + i); } sfx_play(SFX_DEATH); }
    else if (c_spawned >= C_TOTAL && alive == 0) { mg_hold = 30; }
  }
  if (state != S_CATCH) { return; }
  if (c_inv > 0) { c_inv--; m = M_BORED; face_ovr = M_SULK; } else { face_ovr = -1; }
  if (mg_t > 0) { mg_t--; if (face_ovr < 0) { face_ovr = M_JOY; } }
  anim = (frames() >> 3) & 1;
  var vis = 1; if (c_inv > 0 && (c_inv & 4) == 0) { vis = 0; }
  if (vis) { pet_draw(m, 0); } else { hide_sprite(0); hide_sprite(1); }
  hide_sprite(2); hide_sprite(3);
}
func catch_stars() { if (mg_score >= 23) { return 3; } if (mg_score >= 17) { return 2; } if (mg_score >= 10) { return 1; } return 0; }

// ---------------- COPY ME ----------------
btable ar_x = { 72, 98, 46, 72 };      // up, right, left, down: top-left of each arrow sprite
btable ar_y = { 22, 38, 38, 54 };
func arrow_draw() {
  // dirs: 0 up, 1 right, 2 left, 3 down. lit arrows get a colour of their own, the rest are grey
  for (var d = 0; d < 4; d++) {
    var pal = 5;
    if (cp_lit == d) { pal = 2; if (d == 1) { pal = 6; } if (d == 2) { pal = 3; } if (d == 3) { pal = 1; } }
    var tl = T + art_ar_right; var fl = 0;
    if (d == 0) { tl = T + art_ar_up; } if (d == 3) { tl = T + art_ar_up; fl = SPR_FLIPY; } if (d == 2) { fl = SPR_FLIPX; }
    sprite(8 + d, peek8(ar_x + d), peek8(ar_y + d), tl, SPR_16X16 | fl | pal);
  }
}
func cp_start_show() { mg_phase = 1; cp_i = 0; mg_t = 40; cp_lit = -1; clr_row(14); puts(1, 14, "WATCH THE ARROWS..."); }
func cp_light(d) { cp_lit = d; cp_litt = 14; snd_tone4(d); }
func copy_frame() bank 7 {
  var sz = pet_size();
  if (mg_hold > 0) { mg_hold--; if (mg_hold == 0) { mg_finish(copy_stars()); } }
  else if (mg_phase == 0) { mg_t--; if (mg_t <= 0) { cp_start_show(); } }
  else if (mg_phase == 1) {                              // show the sequence
    mg_t--;
    if (mg_t <= 0) {
      if (cp_i < cp_len) {
        cp_light(seq[cp_i]); cp_i++; mg_t = max(14, 28 - cp_round * 2) + 8;
      } else { mg_phase = 2; cp_i = 0; mg_t = 360; clr_row(14); puts(1, 14, "YOUR TURN!"); }
    }
  } else if (mg_phase == 2) {                            // the player copies it
    mg_t--;
    var d = -1;
    if (btnp(BTN_UP)) { d = 0; } else if (btnp(BTN_RIGHT)) { d = 1; } else if (btnp(BTN_LEFT)) { d = 2; } else if (btnp(BTN_DOWN)) { d = 3; }
    var bad = 0;
    if (d >= 0) {
      cp_light(d);
      if (d == seq[cp_i]) {
        cp_i++; mg_t = 360;
        if (cp_i >= cp_len) {
          mg_score = cp_round; face_ovr = M_JOY; mg_phase = 3; mg_t = 50; sfx_play(SFX_COIN);
          clr_row(14); puts(1, 14, "YES! WELL DONE!");
        }
      } else { bad = 1; }
    } else if (mg_t <= 0) { bad = 1; }
    if (bad) {
      mg_lives--; hearts_draw(); face_ovr = M_SULK; sfx_play(SFX_HIT); mg_phase = 4; mg_t = 60;
      clr_row(14); puts(1, 14, "OOPS! LOOK AGAIN...");
    }
  } else if (mg_phase == 3) {                            // round cleared
    mg_t--;
    if (mg_t <= 0) {
      face_ovr = -1;
      if (cp_round >= CP_ROUNDS) { mg_hold = 20; }
      else { cp_round++; cp_len++; print_u(14, 0, cp_round); cp_start_show(); }
    }
  } else if (mg_phase == 4) {                            // a mistake: the same round again
    mg_t--;
    if (mg_t <= 0) {
      face_ovr = -1;
      if (mg_lives <= 0) { mg_hold = 20; } else { cp_start_show(); }
    }
  }
  if (state != S_COPY) { return; }
  if (cp_litt > 0) { cp_litt--; if (cp_litt == 0) { cp_lit = -1; } }
  arrow_draw();
  anim = (frames() >> 4) & 1;
  pxx = 80 - sz / 2;
  pet_draw(M_OK, 0);
  hide_sprite(2); hide_sprite(3);
}
func copy_stars() { if (mg_score >= 6) { return 3; } if (mg_score >= 5) { return 2; } if (mg_score >= 3) { return 1; } return 0; }

// ---------------- HOP ----------------
func hop_frame() bank 7 {
  var sz = pet_size();
  var m = M_OK;
  if (mg_hold > 0) { mg_hold--; if (mg_hold == 0) { mg_finish(hop_stars()); } }
  else {
    // jump: a press on the ground (or up to 6 frames before landing) launches a fixed-height jump
    if (btnp(BTN_A)) { h_buf = 6; }
    if (h_buf > 0) { h_buf--; }
    if (h_jy == 0 && h_vy == 0 && h_buf > 0) { h_vy = 64; h_buf = 0; sfx_play(SFX_JUMP); }
    if (h_jy > 0 || h_vy > 0) {
      h_jy = h_jy + h_vy; h_vy = h_vy - 4;
      if (h_jy <= 0) { h_jy = 0; h_vy = 0; sfx_play(SFX_LAND); }
    }
    // obstacles
    mg_t++;
    h_speed = 10 + (h_spawned * 8) / 5;
    if (sz == 16) { h_speed = h_speed - 1; }
    h_next--;
    if (h_next <= 0 && h_spawned < H_TOTAL) {
      for (var i = 0; i < 3; i++) {
        if (ok_[i] == 0 && h_next <= 0) {
          var r = rand(100); var k = 1;
          if (h_spawned >= 2) { if (r < 35) { k = 2; } else if (r < 65) { k = 3; } }
          ok_[i] = k; ox[i] = 168 * 8; oh[i] = 0; h_spawned++;
          h_next = ((130 + rand(50)) * 8) / h_speed;
        }
      }
    }
    var foot = h_jy >> 4;
    var bw = sz / 2 - 2; var bx = pxx + sz / 4 + 1; var bh = (sz * 2) / 3;
    var alive = 0;
    for (var i = 0; i < 3; i++) {
      if (ok_[i] != 0) {
        ox[i] = ox[i] - h_speed;
        var x = ox[i] >> 3;
        var hit = 0;
        if (oh[i] == 0 && h_inv == 0) {
          if (ok_[i] == 1 && overlap(bx, PYB - foot - bh, bw, bh, x + 1, PYB - 7, 6, 7)) { hit = 1; }
          if (ok_[i] == 2 && overlap(bx, PYB - foot - bh, bw, bh, x + 2, PYB - 7, 12, 7)) { hit = 1; }
          if (ok_[i] == 3 && overlap(bx, PYB - foot - bh, bw, bh, x + 2, PYB - 38, 12, 8)) { hit = 1; }
        }
        if (hit) { oh[i] = 1; mg_lives--; h_inv = 50; sfx_play(SFX_HIT); hearts_draw(); }
        if (x < -16) { if (oh[i] == 0) { mg_score++; hud_score(); sfx_tone(1, 880, 8, 2, 3); } ok_[i] = 0; hide_sprite(8 + i); }
        else {
          alive++;
          if (ok_[i] == 1) { sprite(8 + i, x, PYB - 7, T + art_ob_block, 5); }
          else if (ok_[i] == 2) { sprite(8 + i, x, PYB - 15, T + art_ob_log, SPR_16X16 | 4); }
          else { sprite(8 + i, x, PYB - 42, T + art_bird_a + ((frames() >> 3) & 1) * 4, SPR_16X16 | 2); }
        }
      }
    }
    if (h_inv > 0) { h_inv--; }
    if (mg_lives <= 0) { mg_hold = 50; sfx_play(SFX_DEATH); for (var i = 0; i < 3; i++) { ok_[i] = 0; hide_sprite(8 + i); } }
    else if (h_spawned >= H_TOTAL && alive == 0) { mg_hold = 30; }
  }
  if (state != S_HOP) { return; }
  if (h_inv > 0) { m = M_BORED; face_ovr = M_SULK; } else if (h_jy > 0) { face_ovr = M_JOY; } else { face_ovr = -1; }
  anim = (frames() >> 3) & 1;
  pxx = h_x;
  var vis = 1; if (h_inv > 0 && (h_inv & 4) == 0) { vis = 0; }
  if (vis) { pet_draw(m, h_jy >> 4); } else { hide_sprite(0); hide_sprite(1); }
  hide_sprite(2); hide_sprite(3);
}
func hop_stars() { if (mg_score >= 14) { return 3; } if (mg_score >= 11) { return 2; } if (mg_score >= 7) { return 1; } return 0; }

var mg_sec;
func games_frame() {
  if (state != S_RESULT) { mg_sec++; if (mg_sec >= 60) { mg_sec = 0; clock_second(1); } }     // time passes while playing
  if (state == S_CATCH) { catch_frame(); }
  else if (state == S_COPY) { copy_frame(); }
  else if (state == S_HOP) { hop_frame(); }
  else if (state == S_RESULT) { result_frame(); }
}
