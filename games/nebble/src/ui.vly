// Drawing: palettes (with day, evening, night and lights-out looks), the room, the HUD, the menu, the pet and its effects.

const T = 100;            // static art in tile RAM
const PB = 300;           // the current pet body (32 tiles)
const BLANK = 0;          // an empty cell: tile 0 in palette 0, the dark HUD palette (so clear_bg() makes a dark screen in ~400 cycles)
const PYB = 110;          // y of the floor line the pet stands on

// (the tileset declarations live in main.vly: the web builder does not resolve ../ paths inside imported files)

// ---------- palettes ----------
// bg: 0 hud text on dark, 1 wall, 2 floor and rug, 3 window, 4 good meter, 5 middling meter, 6 low meter, 7 highlight
// obj: 0 pet, 1 gold, 2 red, 3 blue, 4 brown, 5 grey, 6 green, 7 arrows
table PAL_WALL  = { rgb(13,13,9), rgb(11,12,8), rgb(9,6,3), rgb(4,3,1),     rgb(14,10,8), rgb(12,8,6), rgb(7,4,3), rgb(3,2,1),
                    rgb(3,4,9), rgb(4,5,11), rgb(2,2,5), rgb(1,1,3),        rgb(1,1,4), rgb(2,2,5), rgb(1,1,3), rgb(0,0,2) };
table PAL_FLOOR = { rgb(13,10,6), rgb(10,7,4), rgb(12,4,5), rgb(8,2,3),     rgb(12,8,5), rgb(8,5,3), rgb(10,3,4), rgb(6,1,2),
                    rgb(4,3,5), rgb(3,2,4), rgb(5,2,5), rgb(3,1,3),        rgb(1,1,3), rgb(1,1,2), rgb(2,1,3), rgb(1,0,2) };
table PAL_WIN   = { rgb(8,12,15), rgb(15,15,15), rgb(15,14,3), rgb(9,6,3), rgb(15,9,6), rgb(15,13,10), rgb(15,15,6), rgb(8,4,3),
                    rgb(1,1,6), rgb(15,15,15), rgb(15,15,9), rgb(4,3,2),   rgb(0,0,2), rgb(8,8,12), rgb(10,10,8), rgb(2,1,1) };
// pet colours (light, body, outline) for: egg, baby, child, star, dash, pudge, luna, scamp
table PAL_PET = { rgb(15,15,12), rgb(13,12,8), rgb(6,4,3),   rgb(12,15,13), rgb(6,13,10), rgb(2,6,5),   rgb(11,15,15), rgb(4,12,14), rgb(1,4,8),
                  rgb(15,15,9), rgb(15,12,2), rgb(6,3,0),    rgb(10,13,15), rgb(3,8,15), rgb(0,2,8),   rgb(15,12,13), rgb(15,7,10), rgb(7,1,4),
                  rgb(13,12,15), rgb(9,6,14), rgb(3,1,7),    rgb(12,12,6), rgb(8,9,3), rgb(3,3,1) };

// palette writes go through std/fade's copy of the colours, so they survive fades
func pbg(p, a, b, c, d) { fade_bg[p * 4] = a; fade_bg[p * 4 + 1] = b; fade_bg[p * 4 + 2] = c; fade_bg[p * 4 + 3] = d; }
func pobj(p, a, b, c, d) { fade_obj[p * 4] = a; fade_obj[p * 4 + 1] = b; fade_obj[p * 4 + 2] = c; fade_obj[p * 4 + 3] = d; }
func pal_flush() { fade_apply(fade_level); }

func set_look() {                       // wall, floor and window colours for the time of day (or lights out)
  var k = phase() * 4;
  if (sleeping) { k = 12; }
  pbg(1, PAL_WALL[k], PAL_WALL[k + 1], PAL_WALL[k + 2], PAL_WALL[k + 3]);
  pbg(2, PAL_FLOOR[k], PAL_FLOOR[k + 1], PAL_FLOOR[k + 2], PAL_FLOOR[k + 3]);
  pbg(3, PAL_WIN[k], PAL_WIN[k + 1], PAL_WIN[k + 2], PAL_WIN[k + 3]);
}
func set_pet_pal() {
  var i = pet_idx() * 3;
  pobj(0, 0, PAL_PET[i], PAL_PET[i + 1], PAL_PET[i + 2]);
}
func init_pals() {
  pbg(0, rgb(1,1,4), rgb(6,7,10), rgb(11,12,15), rgb(15,15,15));
  pbg(4, rgb(1,1,4), rgb(4,13,4), rgb(12,15,10), rgb(8,9,11));
  pbg(5, rgb(1,1,4), rgb(15,13,2), rgb(15,15,10), rgb(8,9,11));
  pbg(6, rgb(1,1,4), rgb(15,4,3), rgb(15,12,10), rgb(8,9,11));
  pbg(7, rgb(3,5,12), rgb(10,12,15), rgb(13,14,15), rgb(15,15,15));
  pobj(1, 0, rgb(15,15,15), rgb(15,12,2), rgb(5,4,1));
  pobj(2, 0, rgb(15,10,11), rgb(15,3,4), rgb(7,1,2));
  pobj(3, 0, rgb(15,15,15), rgb(10,13,15), rgb(5,8,15));
  pobj(4, 0, rgb(14,11,6), rgb(10,6,3), rgb(5,3,1));
  pobj(5, 0, rgb(13,13,14), rgb(9,9,11), rgb(4,4,6));
  pobj(6, 0, rgb(12,15,6), rgb(6,12,3), rgb(2,5,1));
  pobj(7, 0, rgb(15,15,15), rgb(15,9,2), rgb(5,2,1));
  set_look();
  set_pet_pal();
  fade_saved = 1;
  pal_flush();
}

// ---------- text helpers ----------
func clr_row(r) { for (var c = 0; c < 20; c++) { set_cell(c, r, BLANK); } }
func clr_rows(a, b) { for (var r = a; r <= b; r++) { clr_row(r); } }
func puts(c, r, s) { text_pal = 0; text(c, r, s); }
func putsel(c, r, s) { text_pal = 7; text(c, r, s); text_pal = 0; }

// ---------- the room ----------
func draw_window(slp) {                 // sky inside the window changes with the time of day
  var ph = phase();
  var a = art_sky_cloud; var b = art_sky_sun;
  if (ph == 1) { a = art_sky; b = art_sky_sun; }
  if (ph == 2 || slp) { a = art_sky_stars; b = art_sky_moon; }
  set_cell(4, 4, T + a + (3 << 12));
  set_cell(5, 4, T + b + (3 << 12));
}
func draw_room() bank 8 {
  for (var r = 2; r < 8; r++) { for (var c = 0; c < 20; c++) { set_cell(c, r, T + art_wall_b + (((c + r) & 1) * (art_wall_a - art_wall_b)) + (1 << 12)); } }
  for (var c = 0; c < 20; c++) { set_cell(c, 8, T + art_skirt + (1 << 12)); }
  for (var r = 9; r < 14; r++) { for (var c = 0; c < 20; c++) { set_cell(c, r, T + art_floor_a + ((c + r) & 1) + (2 << 12)); } }
  // window (cols 3..6, rows 3..5)
  set_cell(3, 3, T + art_win_tl + (3 << 12)); set_cell(4, 3, T + art_win_t + (3 << 12)); set_cell(5, 3, T + art_win_t + (3 << 12)); set_cell(6, 3, T + art_win_tr + (3 << 12));
  set_cell(3, 4, T + art_win_l + (3 << 12)); set_cell(6, 4, T + art_win_r + (3 << 12));
  set_cell(3, 5, T + art_win_bl + (3 << 12)); set_cell(4, 5, T + art_win_b + (3 << 12)); set_cell(5, 5, T + art_win_b + (3 << 12)); set_cell(6, 5, T + art_win_br + (3 << 12));
  draw_window(sleeping);
  // a picture and a plant
  for (var i = 0; i < 4; i++) { set_cell(11 + (i & 1), 3 + (i >> 1), T + art_pic + i + (1 << 12)); }
  for (var i = 0; i < 4; i++) { set_cell(16 + (i & 1), 6 + (i >> 1), T + art_plant + i + (1 << 12)); }
  // a rug
  set_cell(5, 11, T + art_rug_tl + (2 << 12)); set_cell(14, 11, T + art_rug_tr + (2 << 12));
  set_cell(5, 12, T + art_rug_bl + (2 << 12)); set_cell(14, 12, T + art_rug_br + (2 << 12));
  for (var c = 6; c < 14; c++) { set_cell(c, 11, T + art_rug_t + (2 << 12)); set_cell(c, 12, T + art_rug_b + (2 << 12)); }
  set_cell(8, 11, T + art_rug_dot + (2 << 12)); set_cell(11, 12, T + art_rug_dot + (2 << 12));
}

// ---------- HUD ----------
func draw_meter(slot, val, ic) {
  var c0 = slot * 5;
  var pal = 4; if (val < 55) { pal = 5; } if (val < 25) { pal = 6; }
  set_cell(c0, 0, T + ic + (pal << 12));
  var v8 = (val * 25) / 100;
  for (var k = 0; k < 3; k++) { set_cell(c0 + 1 + k, 0, T + art_bar0 + clamp(v8 - k * 8, 0, 8) + (pal << 12)); }
  set_cell(c0 + 4, 0, BLANK);
}
func draw_meters() {
  draw_meter(0, hun, art_ic_food); draw_meter(1, fun, art_ic_fun); draw_meter(2, nrg, art_ic_nrg); draw_meter(3, cln, art_ic_cln);
}
table pet_names = { "MOCHI", "PIP", "NIMBO", "BEAN", "TOFU", "ZIPPY", "LUMI", "BOBO" };
table stage_names = { "EGG", "BABY", "CHILD", "ADULT" };
table form_names = { "STARRY", "DASHY", "PUDGY", "LUNA", "SCAMP" };
table time_names = { "DAY", "EVE", "NITE" };
func draw_info() {
  clr_row(1);
  puts(0, 1, pet_names[pname]);
  puts(6, 1, stage_names[stage]);
  puts(12, 1, "D");
  print_u(13, 1, day);
  if (sleeping) { puts(16, 1, "ZZZ"); } else { puts(16, 1, time_names[phase()]); }
}

// ---------- the menu (rows 16-17) ----------
var mcur;
func draw_menu() {
  for (var i = 0; i < 5; i++) {
    var c = i * 4;
    var pal = 0; if (i == mcur) { pal = 7; }
    var b = art_mn_feed + i * 4;
    set_cell(c + 1, 16, T + b + (pal << 12)); set_cell(c + 2, 16, T + b + 1 + (pal << 12));
    set_cell(c + 1, 17, T + b + 2 + (pal << 12)); set_cell(c + 2, 17, T + b + 3 + (pal << 12));
    if (i == mcur) {
      set_cell(c, 16, T + art_brk_l + (7 << 12)); set_cell(c, 17, T + art_brk_l + 1 + (7 << 12));
      set_cell(c + 3, 16, T + art_brk_r + (7 << 12)); set_cell(c + 3, 17, T + art_brk_r + 1 + (7 << 12));
    } else {
      set_cell(c, 16, BLANK); set_cell(c, 17, BLANK); set_cell(c + 3, 16, BLANK); set_cell(c + 3, 17, BLANK);
    }
  }
}
table menu_label = { "FEED ME", "PLAY A GAME", "SLEEP / LIGHTS", "BATH TIME", "ABOUT ME" };

// ---------- the pet itself ----------
var pxx = 64; var ptx = 64; var pdir = 1; var pwait; var anim; var bcnt = 99; var tmoving;
var face_ovr = -1;                   // a face to show instead of the mood's (eating, joy), or -1
btable pet_sz = { 16, 16, 32, 32, 32, 32, 32, 32 };
btable face_x = { 0, 4, 12, 12, 12, 12, 12, 12 };
btable face_y = { 0, 5, 13, 11, 13, 12, 12, 13 };
btable pet_nfr = { 12, 8, 32, 32, 32, 32, 32, 32 };
btable pet_per = { 4, 4, 16, 16, 16, 16, 16, 16 };
table pet_base = { pets_egg0, pets_baby_a, pets_child_a, pets_star_a, pets_dash_a, pets_pudge_a, pets_luna_a, pets_scamp_a };

func pet_idx() { if (stage < 3) { return stage; } return 3 + form; }
func pet_size() { return peek8(pet_sz + pet_idx()); }
func load_pet_art() {
  var i = pet_idx();
  select_bank(bankof(pets));
  load_tiles(pets + pet_base[i] * 16, PB, peek8(pet_nfr + i));
  set_pet_pal();
}
func face_tile(m) {
  if (m == M_HAPPY) { if ((frames() & 255) > 244) { return art_f_blink; } return art_f_happy; }
  if (m == M_OK) { if ((frames() & 255) > 240) { return art_f_blink; } return art_f_neutral; }
  if (m == M_HUNGRY) { return art_f_hungry; }
  if (m == M_BORED) { return art_f_sad; }
  if (m == M_SLEEPY) { return art_f_yawn; }
  if (m == M_DIRTY) { return art_f_dirty; }
  if (m == M_SULK) { return art_f_angry; }
  if (m == M_SLEEP) { return art_f_sleep; }
  if (m == M_EAT) { if ((frames() & 15) < 8) { return art_f_munch_a; } return art_f_munch_b; }
  return art_f_joy;
}
// draw the pet at its position: body in sprite 1, face in sprite 0 (lower slots draw on top). mood m.
func pet_draw(m, yoff) {
  var i = pet_idx();
  var sz = peek8(pet_sz + i);
  var attr = SPR_16X16; if (sz == 32) { attr = SPR_32X32; }
  var fl = 0; if (pdir < 0) { fl = SPR_FLIPX; }
  var y = PYB + 1 - sz - yoff;
  var tile = PB;
  if (stage == 0) {
    var e = 0; if (hp >= 14) { e = 1; } if (hp >= 28) { e = 2; }
    tile = PB + e * 4;
    var sh = 0; if (hp >= 14 && (frames() & 15) < 4) { sh = 1; }
    sprite(1, pxx + sh, y, tile, attr);
    hide_sprite(0);
    return;
  }
  tile = PB + (anim & 1) * peek8(pet_per + i);
  sprite(1, pxx, y, tile, attr | fl);
  var fx = peek8(face_x + i); if (pdir < 0) { fx = sz - 8 - fx; }
  if (tmoving) { fx = fx + pdir; }
  var mm = m; if (face_ovr >= 0) { mm = face_ovr; }
  sprite(0, pxx + fx, y + peek8(face_y + i), T + face_tile(mm), 0);   // slot 0 draws above slot 1
}
// effects around the pet's head by mood (sprites 2 and 3)
func pet_fx(m, yoff) {
  var sz = pet_size();
  var y = PYB + 1 - sz - yoff;
  var t = frames();
  var ex = pxx + sz - 6; var ey = y - 4 - ((t >> 3) & 7);
  if (m == M_SLEEP || m == M_SLEEPY) {
    if ((t & 32) == 0) { sprite(2, ex, ey, T + art_fx_z1, 3); } else { sprite(2, ex + 2, ey - 2, T + art_fx_z2, 3); }
    hide_sprite(3);
  } else if (m == M_JOY || (m == M_HAPPY && (t & 127) < 20)) {
    sprite(2, pxx + sz - 8, y + 2 - ((t >> 2) & 7), T + art_fx_heart, 2);
    sprite(3, pxx, y + 6 - ((t >> 2) & 7), T + art_fx_heart, 2);
  } else if (m == M_BORED) {
    sprite(2, pxx + sz - 8, y + 4 + ((t >> 3) & 3), T + art_fx_sweat, 3);
    hide_sprite(3);
  } else if (m == M_DIRTY) {
    sprite(2, pxx - 4, y + 4 - ((t >> 4) & 1), T + art_fx_stink_a + ((t >> 4) & 1), 6);
    sprite(3, pxx + sz - 4, y + 6 - ((t >> 4) & 1), T + art_fx_stink_b - ((t >> 4) & 1), 6);
  } else if (m == M_SULK) {
    sprite(2, pxx + sz - 8, y - 2 + ((t >> 3) & 1), T + art_fx_anger, 2);
    hide_sprite(3);
  } else if (m == M_HUNGRY && (t & 63) < 30) {
    sprite(2, pxx + sz - 8, y, T + art_it_apple, 2);
    hide_sprite(3);
  } else { hide_sprite(2); hide_sprite(3); }
}
// messes on the floor (sprites 5..7)
btable mess_x = { 22, 118, 76 };
func draw_mess() {
  for (var i = 0; i < 3; i++) {
    if (i < mess) { sprite(5 + i, peek8(mess_x + i), 102 + i * 2, T + art_poop_a + ((frames() >> 4) & 1), 4); }
    else { hide_sprite(5 + i); }
  }
}
